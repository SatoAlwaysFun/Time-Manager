{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Time Manager",
      "type": "shell",
      "command": "mingw32-make",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}